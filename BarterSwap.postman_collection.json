{
  "info": {
    "_postman_id": "9f9a9d9c-4c8c-4d65-a2ba-barterswap-existing-data",
    "name": "BarterSwap API - données existantes",
    "description": "Collection Postman basée uniquement sur des données déjà présentes en base. Aucune création d'utilisateur/service/échange n'est effectuée.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "providerId", "value": "" },
    { "key": "serviceId", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Bootstrap depuis la BDD",
      "item": [
        {
          "name": "Lister les services existants (sélectionne le premier)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/services?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"],
              "query": [
                { "key": "limit", "value": "50" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Liste services: 200', function () { pm.response.to.have.status(200); });",
                  "const services = pm.response.json();",
                  "pm.test('Au moins un service existe en BDD', function () { pm.expect(Array.isArray(services) && services.length > 0, 'Aucun service trouvé en base.').to.eql(true); });",
                  "if (Array.isArray(services) && services.length > 0) {",
                  "  const selected = services[0];",
                  "  pm.collectionVariables.set('serviceId', String(selected.id));",
                  "  pm.collectionVariables.set('providerId', String(selected.provider_id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter le service sélectionné",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "{{serviceId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Service sélectionné: 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Utilisateur fournisseur",
      "item": [
        {
          "name": "Consulter le profil fournisseur",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{providerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{providerId}}"]
