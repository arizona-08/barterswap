          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Profil fournisseur: 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter les compétences du fournisseur",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{providerId}}/skills",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{providerId}}", "skills"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Skills fournisseur: 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Services et filtres",
      "item": [
